# Скопируйте в .env и заполните

# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Ключ, которым бот подписывает запросы к API (придумайте любую длинную строку)
SERVICE_KEY=change-me-to-a-long-random-string

# Сколько участников нужно, чтобы начать голосование (1 — удобно для демо в одиночку)
MIN_PARTICIPANTS=2

# Для запуска API без Docker и PostgreSQL: STORAGE=memory
# STORAGE=postgres
# DATABASE_URL=postgresql+asyncpg://kinomatch:kinomatch@localhost:5432/kinomatch
# REDIS_URL=redis://localhost:6379/0
# API_URL=http://localhost:8000
